# ---- Godot 4 editor state (regenerated whenever the project opens) ----
.godot/

# ---- build output ----
# Breakout.exe is ~120 MB: it ships as a GitHub Release asset, and GitHub
# refuses regular git blobs over 100 MB anyway. Re-export with:
#   godot --headless --path breakout-game-godot \
#     --export-release "Windows Desktop" build/Breakout.exe
build/

# ---- dev-tool artifacts ----
# boot screenshots written by tools/shot_on_boot.gd — all scratch except one pinned
# hero shot that README.md embeds: reshooting refreshes the README image in place,
# and git simply notices the pixels changed
.shots/*
!.shots/5_fun.png
# legacy scratch save dirs; live dev runs now redirect user:// to
# %APPDATA%\Breakout Godot (Godot 4.7 has no --user-data-dir flag — see DEV-NOTES.md)
.test_userdata/
.dev_userdata/
# pressed-paper redesign scratch: Python bytecode + per-direction mockups (tools/mock_up.py)
__pycache__/
_mocks/

# ---- local dev notes (machine-specific paths; deliberately untracked) ----
DEV-NOTES.md
features_implemntation_plan.md
